generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("PRISMA_DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  passwordHash   String?
  role           String   @default("member")
  avatarUrl      String?
  oauthProvider  String?
  isActive       Boolean  @default(true)
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())

  channel        Channel?
  comments       Comment[]
  votes          Vote[]
  subscriptions  Subscription[]
  flags          Flag[]
  adminActions   AdminAction[]
  watchHistory   WatchHistory[]
  savedVideos    SavedVideo[]
  notifications  Notification[]
}

model Channel {
  id              String   @id @default(cuid())
  userId          String   @unique
  channelName     String
  description     String?
  bannerUrl       String?
  subscriberCount Int      @default(0)
  videoCount      Int      @default(0)
  isSuspended     Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos          Video[]
  subscriptions   Subscription[]
  playlists       Playlist[]
}

model Video {
  id              String   @id @default(cuid())
  channelId       String
  title           String
  description     String?
  videoUrl        String
  thumbnailUrl    String?
  durationSeconds Int?
  aspectRatio     String   @default("9:16")
  format          String   @default("portrait")
  status          String   @default("processing")
  viewCount       Int      @default(0)
  likeCount       Int      @default(0)
  dislikeCount    Int      @default(0)
  isRemoved       Boolean  @default(false)
  createdAt       DateTime @default(now())

  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  comments        Comment[]
  votes           Vote[]
  flags           Flag[]
  categories      VideoCategory[]
  tags            VideoTag[]
  playlistItems   PlaylistItem[]
  watchHistory    WatchHistory[]
  savedBy         SavedVideo[]

  // Indexes for the most common query patterns.
  // Without these, every list/feed query does a seq scan on Video.
  //
  // 1. Home feed + /explore + /search "latest" sort:
  //    WHERE isRemoved=false AND status='ready' ORDER BY createdAt DESC
  // 2. Trending + "views" sort:
  //    WHERE isRemoved=false AND status='ready' ORDER BY viewCount DESC
  // 3. Channel page: WHERE channelId=? AND isRemoved=false AND status='ready'
  //
  // The composite (isRemoved, status, createdAt) index covers #1 and
  // also serves as a covering index for the WHERE clause in #2.
  // (isRemoved, status, viewCount) covers #2's sort.
  // (channelId, isRemoved, status) covers #3.
  @@index([isRemoved, status, createdAt])
  @@index([isRemoved, status, viewCount])
  @@index([channelId, isRemoved, status])
}

model Comment {
  id        String   @id @default(cuid())
  videoId   String
  userId    String
  content   String
  isRemoved Boolean  @default(false)
  createdAt DateTime @default(now())

  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Index for fetching a video's comments ordered by date.
  // Pattern: WHERE videoId=? AND isRemoved=false ORDER BY createdAt DESC
  @@index([videoId, isRemoved, createdAt])
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  voteType  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Subscription {
  id                 String   @id @default(cuid())
  subscriberId       String
  channelId          String
  emailNotifications Boolean  @default(false)
  createdAt          DateTime @default(now())

  subscriber         User     @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  channel            Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, channelId])
}

model Flag {
  id         String   @id @default(cuid())
  videoId    String
  reportedBy String
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporter   User     @relation(fields: [reportedBy], references: [id], onDelete: Cascade)
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  targetType String
  targetId   String
  action     String
  reason     String?
  createdAt  DateTime @default(now())

  admin      User     @relation(fields: [adminId], references: [id])
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  iconUrl     String?
  createdAt   DateTime @default(now())

  videos      VideoCategory[]
}

model VideoCategory {
  videoId     String
  categoryId  String

  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([videoId, categoryId])
}

model Playlist {
  id          String   @id @default(cuid())
  channelId   String
  title       String
  description String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())

  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  items       PlaylistItem[]
}

model PlaylistItem {
  id          String   @id @default(cuid())
  playlistId  String
  videoId     String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  playlist    Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  video       Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now())
  progress  Float    @default(0)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  // One history row per (user, video). Without this, concurrent requests
  // to /api/v1/videos/[id] (page load + history POST fired in parallel)
  // could both pass the findFirst check and create duplicate rows,
  // inflating view counts. Run `prisma db push` after pulling this change.
  @@unique([userId, videoId])
}

model SavedVideo {
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
}

/// In-app notification delivered to a specific user.
/// Types are intentionally string-typed so we can add new kinds
/// (subscription, comment, vote, flag, admin, system) without migrations.
model Notification {
  id              String   @id @default(cuid())
  userId          String   // recipient
  type            String   // subscription | comment | vote | flag | admin | system
  title           String
  message         String
  actorId         String?  // who triggered it (null for system)
  relatedVideoId  String?  // optional context
  relatedChannelId String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

/// Freeform tag (hashtag) attached to videos for discovery.
/// Distinct from Category (curated taxonomy) — tags are creator-defined
/// and reflect how the community actually describes content.
model Tag {
  id        String      @id @default(cuid())
  name      String      @unique // normalized: lowercase, no spaces
  label     String      // display form, preserves original casing
  usageCount Int        @default(0) // denormalized for fast "popular tags" queries
  createdAt DateTime    @default(now())

  videos    VideoTag[]
}

/// Join table — many-to-many between Video and Tag.
/// Cascade-delete on Video so removing a video cleans up its tag associations.
model VideoTag {
  videoId String
  tagId   String

  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
  @@index([tagId])
}
