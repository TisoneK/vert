# ─── Vert — Environment Variables ───────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env or .env.local to version control.

# ── Database (PostgreSQL via Prisma) ────────────────────────────────────────
# Connection string for the Prisma client (runtime queries).
# For local dev: postgresql://user:password@localhost:5432/vert
# For Neon/Vercel Postgres: use the pooled connection string from your dashboard.
# Serverless pool params (connection_limit=1&pool_timeout=10) are appended
# automatically by src/lib/db.ts — you do NOT need to add them here.
DATABASE_URL=postgresql://user:password@localhost:5432/vert

# Direct connection URL for Prisma migrations (bypasses connection pooler).
# Only needed when using a pooled connection for DATABASE_URL above.
# For local single-instance Postgres, this can be the same as DATABASE_URL.
# PRISMA_DATABASE_URL=postgresql://user:password@localhost:5432/vert

# ── NextAuth (Authentication) ──────────────────────────────────────────────
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=changeme_replace_with_random_secret

# The canonical URL of your app (used in auth callbacks).
# Local dev: http://localhost:3000
# Production: https://vert-wine.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Google OAuth (Optional) ─────────────────────────────────────────────────
# Only needed if you want Google sign-in to work in local dev.
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ── Vercel Blob (File Uploads) ──────────────────────────────────────────────
# Required for video/image upload functionality.
# Set VERT_BLOB_READ_WRITE_TOKEN if you have a manually created Blob store.
# Falls back to BLOB_READ_WRITE_TOKEN (auto-set when store is connected via
# Vercel dashboard).
# VERT_BLOB_READ_WRITE_TOKEN=your-blob-token

# ── Admin / Internal (Optional) ──────────────────────────────────────────────
# Secret key for protected internal endpoints (seed, cleanup-demo).
# Must match the value expected by the endpoint.
# SEED_KEY=your-secret-key
